{
  "mcpServers": {
    "injective-docs": {
      "url": "https://docs.injective.network/mcp"
    },
    "injective-trading": {
      "command": "node",
      "args": ["vendor/mcp-server/dist/mcp/server.js"],
      "env": {
        "INJECTIVE_NETWORK": "testnet"
      }
    },
    "intentguard-policy": {
      "command": "node",
      "args": [
        "--experimental-strip-types",
        "apps/intentguard/src/mcp/server.ts"
      ],
      "env": {
        "INJECTIVE_NETWORK": "testnet"
      }
    },
    "intentguard-agent": {
      "command": "bash",
      "args": ["scripts/run-intentguard-agent-mcp.sh"],
      "env": {
        "INJECTIVE_NETWORK": "testnet"
      }
    }
  }
}
