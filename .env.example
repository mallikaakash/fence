# Copy to .env — never commit real keys.

# Default network for local MCP and CLI work
INJECTIVE_NETWORK=testnet

# Public endpoints (override if Injective docs recommend newer URLs)
INJECTIVE_RPC_URL=
INJECTIVE_REST_URL=
INJECTIVE_GRPC_URL=

# Optional: read-only / test accounts (never mainnet seeds in .env)
# INJECTIVE_TEST_ADDRESS=inj1...
