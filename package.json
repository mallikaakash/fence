{
  "name": "injective-buildathon",
  "private": true,
  "description": "Scaffold for Injective hackathon research and agentic dev — no app code until you choose a track.",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "skills:install": "bash scripts/install-skills.sh",
    "skills:update": "npx --yes skills update",
    "mcp:build": "npm install && npm run build --prefix vendor/mcp-server",
    "doctor": "bash scripts/doctor.sh",
    "intentguard:test": "npm test --prefix apps/intentguard",
    "intentguard:demo": "npm run demo --prefix apps/intentguard",
    "intentguard:audit": "npm run audit --prefix apps/intentguard",
    "intentguard:web": "npm run web:dev --prefix apps/intentguard",
    "intentguard:gateway": "npm run gateway --prefix apps/intentguard",
    "intentguard:smoke": "npm run product:smoke --prefix apps/intentguard",
    "intentguard:security": "npm run security:verify --prefix apps/intentguard",
    "intentguard:e2e": "npm run e2e:protocol --prefix apps/intentguard",
    "intentguard:gtm": "npm run gtm:verify --prefix apps/intentguard",
    "intentguard:platform": "npm run platform:verify --prefix apps/intentguard",
    "intentguard:ux": "npm run ux:verify --prefix apps/intentguard",
    "vercel-build": "npm install --prefix apps/intentguard/web && npm run build --prefix apps/intentguard/web"
  },
  "engines": {
    "node": ">=20"
  }
}
