{
  "name": "injective-buildathon",
  "private": true,
  "description": "Scaffold for Injective hackathon research and agentic dev — no app code until you choose a track.",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "skills:install": "bash scripts/install-skills.sh",
    "skills:update": "npx --yes skills update",
    "mcp:build": "npm install && npm run build --prefix vendor/mcp-server",
    "doctor": "bash scripts/doctor.sh",
    "intentguard:test": "npm test --prefix apps/intentguard",
    "intentguard:demo": "npm run demo --prefix apps/intentguard",
    "intentguard:audit": "npm run audit --prefix apps/intentguard",
    "intentguard:web": "npm run web:dev --prefix apps/intentguard"
  },
  "engines": {
    "node": ">=20"
  }
}
