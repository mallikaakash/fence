# IntentGuard sidecar (copy to .env — never commit)
INTENTGUARD_PORT=8787
# Default 127.0.0.1 — use INTENTGUARD_BIND=0.0.0.0 only behind a firewall / in Docker (DOCKER=1)
INTENTGUARD_BIND=127.0.0.1
INTENTGUARD_OWNER_API_KEY=
# Policy-only default. Set to 1 + owner key for live MsgExec on your network.
INTENTGUARD_EXECUTE=0
INTENTGUARD_OWNER_PRIVATE_KEY_HEX=
INJECTIVE_NETWORK=testnet
INTENTGUARD_REQUIRE_ONCHAIN_GRANT=1
# openssl rand -hex 32
INTENTGUARD_DATA_KEY=
INTENTGUARD_REQUIRE_DATA_KEY=1
INTENTGUARD_CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
INTENTGUARD_MAX_BODY_BYTES=65536
INTENTGUARD_RATE_LIMIT_PER_MIN=120
# Optional webhook for propose/execute audit events (HTTPS URL)
INTENTGUARD_WEBHOOK_URL=
